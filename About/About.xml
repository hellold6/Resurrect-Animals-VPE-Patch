<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <packageId>hellold6.resurrectanimals</packageId>
  <name>Resurrect Animals (VPE Patch)</name>
  <author>hellold6</author>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>Small Harmony patch for Vanilla Psycasts Expanded: allows the Necropath "Resurrect" ability to target animal corpses in addition to humanlike corpses. Other corpse-targeting abilities (Corpsetalk, Enthrall, etc) are untouched.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>OskarPotocki.VanillaFactionsExpanded.Core</packageId>
      <displayName>Vanilla Expanded Framework</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2023507013</steamWorkshopUrl>
      <downloadUrl>https://github.com/Vanilla-Expanded/VanillaExpandedFramework</downloadUrl>
    </li>
    <li>
      <packageId>VanillaExpanded.VPsycastsE</packageId>
      <displayName>Vanilla Psycasts Expanded</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2842502659</steamWorkshopUrl>
      <downloadUrl>https://github.com/Vanilla-Expanded/VanillaPsycastsExpanded</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>VanillaExpanded.VPsycastsE</li>
  </loadAfter>
</ModMetaData>
